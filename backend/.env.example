# App
SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
APP_NAME=amzur-ai-chat
ENVIRONMENT=development

# Domain restriction (applied to both email/password and Google OAuth)
# JSON array or comma-separated list
ALLOWED_DOMAINS=["amzur.com","evokesystems.com"]

# Frontend origin (used for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Database — use postgresql+asyncpg:// or bare postgresql://
DATABASE_URL=postgresql://user:password@localhost:5432/amzur_ai_chat

# Amzur LiteLLM Proxy
LITELLM_PROXY_URL=https://litellm.amzur.com
LITELLM_API_KEY=sk-your-key-here
LLM_MODEL=gemini/gemini-2.5-flash
LITELLM_EMBEDDING_MODEL=text-embedding-3-large
IMAGE_GEN_MODEL=gemini/imagen-4.0-fast-generate-001

# Google OAuth (optional — leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# Google Sheets service account (optional — leave blank to disable Sheets integration)
GOOGLE_SERVICE_ACCOUNT_JSON=

# File uploads
MAX_UPLOAD_MB=20
UPLOAD_DIR=./uploads

# ── n8n automation sidecar (fill in after activating workflows in session) ──
N8N_WEBHOOK_URL=https://achanta-srilakshmi.app.n8n.cloud/webhook/1c9ae640-d29d-4c93-8a1f-b66f33d9c60a/webhook
N8N_API_KEY=
N8N_STATUS_WEBHOOK_URL=